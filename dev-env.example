# dev-env.local — local-dev master (gitignored). Single source of truth for .env.local files.
# Apply:   node scripts/apply-dev-env.mjs [--force]
# Re-seed: node scripts/apply-dev-env.mjs --seed

[apps/admin/.env.local]
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=
NEXTAUTH_SECRET=
POSTGRES_URL=
NEXT_PUBLIC_APP_URL=
AUTH_SECRET=
AUTH_URL=
DATABASE_URL=
GOOGLE_API_SECRET=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=

[apps/user/.env.local]
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXTAUTH_SECRET=
POSTGRES_URL=
LOG_LEVEL=
NEXT_PUBLIC_LOG_LEVEL=
AUTH_SECRET=
AUTH_URL=
NEXT_PUBLIC_APP_URL=
DATABASE_URL=
GOOGLE_API_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_CLIENT_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
MOLLIE_API_KEY=
NEXT_PUBLIC_MOLLIE_PROFILE_ID=
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=
RECONCILIATION_SECRET=

# Stripe Connect (track 028): Connect platform key (direct-charge status/refunds) + signing secret for /api/webhooks/stripe-connect
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Viva Smart Checkout (online, track 028). VIVA_MODE=stub|http is shared with the Cloud Terminal rail.
VIVA_MODE=
VIVA_CHECKOUT_SOURCE_CODE=
VIVA_CHECKOUT_COLOR=
# Returned by GET /api/webhooks/viva for Viva's URL-verification handshake
VIVA_WEBHOOK_VERIFICATION_KEY=

[apps/partner/.env.local]
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=
NEXTAUTH_SECRET=
POSTGRES_URL=
NEXT_PUBLIC_APP_URL=
AUTH_SECRET=
AUTH_URL=
DATABASE_URL=
GOOGLE_API_SECRET=
BLOB_READ_WRITE_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
# Stripe Connect (track 028): secret/restricted key of the Connect platform account (separate from STRIPE_SECRET_KEY; falls back to it if unset)
STRIPE_CONNECT_SECRET_KEY=
# Stripe Connect (track 028): signing secret for the Connect-account webhook (account.updated / capability.updated)
STRIPE_CONNECT_ACCOUNT_WEBHOOK_SECRET=
# Stripe publishable key for embedded Connect components / Stripe.js in the browser
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# Publishable key of the Stripe CONNECT platform account (embedded components); falls back to the key above
NEXT_PUBLIC_STRIPE_CONNECT_PUBLIC_KEY=
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=
MOLLIE_ORG_TOKEN=
RESEND_API_KEY=

[packages/data/.env.local]
POSTGRES_URL_TEST=
POSTGRES_URL=
