{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    // TypeScript 6 no longer auto-includes global @types packages (types defaults to []);
    // the ambient `google` namespace (Maps JS API) must be listed explicitly.
    "types": ["google.maps"],
    "paths": {
      "@/*": ["./*"]
    },
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
