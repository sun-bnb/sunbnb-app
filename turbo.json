{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "POSTGRES_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_PUBLIC_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_SUBSCRIPTION_WEBHOOK_SECRET",
    "MOLLIE_API_KEY",
    "MOLLIE_CLIENT_ID",
    "MOLLIE_CLIENT_SECRET",
    "MOLLIE_ORG_TOKEN",
    "NEXT_PUBLIC_MOLLIE_PROFILE_ID",
    "RECONCILIATION_SECRET",
    "GOOGLE_MAPS_API_KEY",
    "AUTH_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "AUTH_FACEBOOK_ID",
    "AUTH_FACEBOOK_SECRET",
    "BLOB_READ_WRITE_TOKEN",
    "NEXT_PUBLIC_DEMO_MODE",
    "VERCEL_ENV",
    "NEXT_PUBLIC_APP_ENV",
    "RESEND_API_KEY",
    "NEXT_PUBLIC_GOOGLE_MAPS_CLIENT_KEY",
    "NODE_ENV",
    "ALLOWED_ORIGINS",
    "FF_RESTAURANTS",
    "CONSUMER_APP_URL",
    "HW_CLIENT_UA"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
