# Knowledge store config. NO API KEYS REQUIRED — embeddings run locally (transformers.js)
# and distillation uses your existing `claude` CLI auth. Every value has a working default;
# copy this to .claude/.env.knowledge only if you want to override something.

KNOWLEDGE_DB_URL=postgres://postgres:sunbnb@localhost:5434/sunbnb_knowledge
EMBED_MODEL=Xenova/bge-small-en-v1.5
DISTILL_MODEL=claude-haiku-4-5
# CLAUDE_BIN=claude
