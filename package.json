{
  "name": "sunbnb-app",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "coverage": "(cd apps/partner && npm run test:coverage)",
    "e2e": "npm run e2e -w @repo/e2e"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.30",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.11",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "dependencies": {
  }
}
