{
  "name": "sunbnb-app",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "coverage:ratchet": "(cd apps/partner && npm run test:coverage) && node scripts/coverage-ratchet.mjs",
    "coverage:baseline": "(cd apps/partner && npm run test:coverage) && node scripts/coverage-ratchet.mjs --update"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "prettier": "^3.2.5",
    "turbo": "^2.0.11",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
  }
}
