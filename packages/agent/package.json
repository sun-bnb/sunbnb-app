{
  "name": "@repo/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./claude-model": "./src/claude-model.ts",
    "./loop": "./src/loop.ts",
    "./limits": "./src/limits.ts",
    "./schema": "./src/schema.ts",
    "./geo/*": "./src/geo/*.ts",
    "./vision/*": "./src/vision/*.ts"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./src/index.ts"
      ],
      "model": [
        "./src/model.ts"
      ],
      "claude-model": [
        "./src/claude-model.ts"
      ],
      "loop": [
        "./src/loop.ts"
      ],
      "limits": [
        "./src/limits.ts"
      ],
      "schema": [
        "./src/schema.ts"
      ],
      "geo/*": [
        "./src/geo/*.ts"
      ],
      "vision/*": [
        "./src/vision/*.ts"
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@repo/schematic": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
