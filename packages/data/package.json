{
  "name": "@repo/data",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./PrismaCient": "./index.ts",
    "./auth": "./src/auth.ts",
    "./payment": "./src/payment.ts",
    "./settlement": "./src/settlement.ts",
    "./subscription": "./src/subscription.ts",
    "./TextField": "./src/TextField.tsx",
    "./button": "./src/button.tsx",
    "./card": "./src/card.tsx",
    "./code": "./src/code.tsx",
    "./env": "./src/env.ts",
    "./business-entity": "./src/business-entity.ts",
    "./email": "./src/email.ts",
    "./reservation-emails": "./src/reservation-emails.ts",
    "./password-reset": "./src/password-reset.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./reservation-status": "./src/reservation-status.ts",
    "./flags": "./src/flags.ts",
    "./impersonation": "./src/impersonation.ts",
    "./mollie-tokens": "./src/mollie-tokens.ts",
    "./seat-label": "./src/seat-label.ts",
    "./seat-label-db": "./src/seat-label-db.ts",
    "./reservations": "./src/reservations.ts"
  },
  "typesVersions": {
    "*": {
      "PrismaCient": [
        "./index.ts"
      ],
      "auth": [
        "./src/auth.ts"
      ],
      "payment": [
        "./src/payment.ts"
      ],
      "settlement": [
        "./src/settlement.ts"
      ],
      "subscription": [
        "./src/subscription.ts"
      ],
      "TextField": [
        "./src/TextField.tsx"
      ],
      "button": [
        "./src/button.tsx"
      ],
      "card": [
        "./src/card.tsx"
      ],
      "code": [
        "./src/code.tsx"
      ],
      "env": [
        "./src/env.ts"
      ],
      "business-entity": [
        "./src/business-entity.ts"
      ],
      "rate-limit": [
        "./src/rate-limit.ts"
      ],
      "reservation-status": [
        "./src/reservation-status.ts"
      ],
      "flags": [
        "./src/flags.ts"
      ],
      "impersonation": [
        "./src/impersonation.ts"
      ],
      "mollie-tokens": [
        "./src/mollie-tokens.ts"
      ],
      "seat-label": [
        "./src/seat-label.ts"
      ],
      "seat-label-db": [
        "./src/seat-label-db.ts"
      ],
      "reservations": [
        "./src/reservations.ts"
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "postinstall": "npx prisma generate",
    "migrate:local": "cp .env.local .env && npx prisma migrate dev && npx prisma generate && (npm run migrate:integration || echo '⚠ sunbnb_test not migrated — create the DB if you run integration tests')",
    "migrate:integration": "POSTGRES_URL=postgres://postgres:sunbnb@localhost:5432/sunbnb_test npx prisma migrate deploy",
    "migrate:test": "./scripts/with-db-url.sh POSTGRES_URL_TEST npx prisma migrate deploy && npx prisma generate",
    "migrate:production": "./scripts/with-db-url.sh POSTGRES_URL_PRODUCTION npx prisma migrate deploy && npx prisma generate",
    "migrate:check": "./scripts/with-db-url.sh POSTGRES_URL npx prisma migrate diff --from-config-datasource --to-schema ./prisma/schema.prisma --exit-code",
    "migrate:status:local": "./scripts/with-db-url.sh POSTGRES_URL npx prisma migrate status",
    "migrate:status:test": "./scripts/with-db-url.sh POSTGRES_URL_TEST npx prisma migrate status",
    "migrate:status:production": "./scripts/with-db-url.sh POSTGRES_URL_PRODUCTION npx prisma migrate status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "POSTGRES_URL=postgres://postgres:sunbnb@localhost:5432/sunbnb_test vitest run --config vitest.integration.config.ts",
    "test:integration:setup": "npm run migrate:integration",
    "prewarm:mollie:test": "./scripts/with-db-url.sh POSTGRES_URL_TEST npx --yes tsx scripts/prewarm-mollie-tokens.ts",
    "prewarm:mollie:production": "./scripts/with-db-url.sh POSTGRES_URL_PRODUCTION npx --yes tsx scripts/prewarm-mollie-tokens.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@repo/typescript-config": "*",
    "@turbo/gen": "^1.12.4",
    "@types/eslint": "^8.56.5",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.18.0",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.3.3",
    "vitest": "^3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "dotenv": "^17.3.1",
    "pg": "^8.19.0",
    "prisma": "^7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.3"
  }
}
