    "verifactu:subsanar:production": "./scripts/with-db-url.sh POSTGRES_URL_PRODUCTION npx --yes tsx scripts/verifactu-subsanar.ts",
    "verifactu:health:local": "npx --yes tsx scripts/verifactu-health.ts",
