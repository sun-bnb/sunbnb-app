    "backfill:site-codes:production:dry": "./scripts/with-db-url.sh POSTGRES_URL_PRODUCTION npx --yes tsx scripts/backfill-site-codes.ts --dry-run",
    "backfill:site-codes:production": "./scripts/with-db-url.sh POSTGRES_URL_PRODUCTION npx --yes tsx scripts/backfill-site-codes.ts",
    "backfill:units:local:dry": "npx --yes tsx scripts/backfill-units.ts --dry-run",
