{
  "name": "@repo/data",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./PrismaCient": "./index.ts",
    "./auth": "./src/auth.ts",
    "./payment": "./src/payment.ts",
    "./settlement": "./src/settlement.ts",
    "./subscription": "./src/subscription.ts",
    "./TextField": "./src/TextField.tsx",
    "./button": "./src/button.tsx",
    "./card": "./src/card.tsx",
    "./code": "./src/code.tsx",
    "./env": "./src/env.ts",
    "./business-entity": "./src/business-entity.ts",
    "./email": "./src/email.ts",
    "./reservation-emails": "./src/reservation-emails.ts",
    "./password-reset": "./src/password-reset.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./reservation-status": "./src/reservation-status.ts"
  },
  "typesVersions": {
    "*": {
      "PrismaCient": [
        "./index.ts"
      ],
      "auth": [
        "./src/auth.ts"
      ],
      "payment": [
        "./src/payment.ts"
      ],
      "settlement": [
        "./src/settlement.ts"
      ],
      "subscription": [
        "./src/subscription.ts"
      ],
      "TextField": [
        "./src/TextField.tsx"
      ],
      "button": [
        "./src/button.tsx"
      ],
      "card": [
        "./src/card.tsx"
      ],
      "code": [
        "./src/code.tsx"
      ],
      "env": [
        "./src/env.ts"
      ],
      "business-entity": [
        "./src/business-entity.ts"
      ],
      "rate-limit": [
        "./src/rate-limit.ts"
      ],
      "reservation-status": [
        "./src/reservation-status.ts"
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "postinstall": "npx prisma generate",
    "migrate:local": "cp .env.local .env && source .env && npx prisma migrate dev && npx prisma generate",
    "migrate:test": "cp .env.test .env && source .env && npx prisma migrate dev && npx prisma generate && cp .env.local .env && source .env",
    "migrate:production": "cp .env.production .env && source .env && npx prisma migrate dev && npx prisma generate && cp .env.local .env && source .env"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@turbo/gen": "^1.12.4",
    "@types/eslint": "^8.56.5",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.18.0",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "dotenv": "^17.3.1",
    "pg": "^8.19.0",
    "prisma": "^7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.3"
  }
}
