generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum SettlementStatus {
  DRAFT
  CLOSED
  APPROVED
  PAID
}

enum SubscriptionTier {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model SubscriptionPlan {
  id              String           @id @default(cuid())
  tier            SubscriptionTier @unique
  name            String
  monthlyPrice    Float            @map("monthly_price")
  maxSites        Int              @map("max_sites")
  stripeProductId String?          @map("stripe_product_id")
  stripePriceId   String?          @map("stripe_price_id")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  partnerAccountId     String             @unique @map("partner_account_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  partnerAccount       PartnerAccount     @relation(fields: [partnerAccountId], references: [userId], onDelete: Cascade)
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
}

model Settings {
  id             String       @id @default(cuid())
  country        String?
  vat            Float?
  currency       String?
  companyName    String?      @map("company_name")
  companyAddress String?      @map("company_address")
  businessId     String?      @map("business_id")
  vatId          String?      @map("vat_id")
  contactEmail   String?      @map("contact_email")
  contactPhone   String?      @map("contact_phone")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  serviceFees    ServiceFee[]
}

model ServiceCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceFee {
  id               String            @id @default(cuid())
  settingsId       String            @map("settings_id")
  siteId           String?           @map("site_id")
  accountId        String?           @map("account_id")
  subscriptionTier SubscriptionTier? @map("subscription_tier")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  chargeType       String            @map("charge_type")
  feeAmount        Float?            @map("fee_amount")
  percentage       Float?
  serviceCode      String            @map("service_code")
  // Optional product scope. NULL = applies to any product (beachclub or
  // restaurant). "beachclub" or "restaurant" = product-scoped. Brand-neutral
  // values so rebrands don't force a data migration.
  product          String?           @map("product")
  account          PartnerAccount?   @relation(fields: [accountId], references: [userId], onDelete: Cascade)
  settings         Settings          @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  site             Site?             @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model PaymentProcessingFee {
  id          String   @id @default(cuid())
  name        String   @default("Default")
  fixedAmount Float?   @map("fixed_amount")
  percentage  Float?
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String               @id @default(cuid())
  name           String?
  email          String               @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  password       String?
  sudo           Boolean              @default(false)
  accounts       Account[]
  Authenticator  Authenticator[]
  inventoryItems InventoryItem[]
  orders         Order[]
  partnerAccount PartnerAccount?
  passwordResetTokens PasswordResetToken[]
  rentalBookings RentalBooking[]
  reservations   Reservation[]
  sessions       Session[]
  sites          Site[]
  tableReservations TableReservation[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model PartnerAccount {
  /// Stable EXTERNAL identifier (track 021). Devices are flashed with this, not
  /// with `userId`, so an account restructure is a repoint here rather than a
  /// reflash of every potted unit. Nullable during expand; backfilled.
  code        String?      @unique
  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  email       String
  phoneNumber String       @map("phone_number")
  company     String
  websiteUrl  String?      @map("website_url")
  address     String
  city        String?
  postalCode  String?      @map("postal_code")
  country     String?
  bankAccount          String?      @map("bank_account")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  userId               String       @id @unique @map("user_id")
  businessId           String?      @map("business_id")
  mollieProfileId      String?      @map("mollie_profile_id")
  mollieAccessToken    String?      @map("mollie_access_token")
  mollieRefreshToken   String?      @map("mollie_refresh_token")
  mollieTokenExpiresAt DateTime?    @map("mollie_token_expires_at")
  mollieOnboardingStatus String?    @map("mollie_onboarding_status")
  invoices            Invoice[]
  settlements         Settlement[]
  subscription        Subscription?
  customSubscription  CustomSubscription?
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceFees         ServiceFee[]
  restaurants         Restaurant[]
  employees           Employee[]
}

model CustomSubscription {
  id               String         @id @default(cuid())
  partnerAccountId String         @unique @map("partner_account_id")
  maxSites         Int?           @map("max_sites")
  notes            String?
  featureOverrides Json?          @map("feature_overrides")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  partnerAccount   PartnerAccount @relation(fields: [partnerAccountId], references: [userId], onDelete: Cascade)
}

model Site {
  id              String                   @id @unique @default(cuid())
  /// Stable EXTERNAL identifier (track 022) — the site half of the printed QR
  /// URL: `/q/S-K7M2X9/1-1-1`. `id` is a 25-char cuid, which was half of an
  /// 80-character URL and therefore half of the card's QR-density problem.
  ///
  /// NOT `slug`: that one is partner-editable (a rename would silently kill
  /// every card already glued to a lounger at that venue), variable-length, and
  /// carries no uniqueness constraint here.
  ///
  /// Public, and authenticates nothing — it is printed on a card on a public
  /// beach and routes to a public booking page. Format and minting rules live in
  /// `src/site-code.ts`. Nullable during expand; backfilled.
  code            String?                  @unique
  userId          String                   @map("user_id")
  name            String
  locationLat     String                   @map("location_lat")
  locationLng     String                   @map("location_lng")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  description     String?
  image           String?
  coords          Unsupported("geometry")?
  price           Float?
  imageHeight     Int?                     @map("image_height")
  imageWidth      Int?                     @map("image_width")
  services        String[]                 @default([])
  vat             Float?
  rentalVat       Float?                   @map("rental_vat")
  rentalPaymentType String?                @map("rental_payment_type")
  status          String                   @default("active")
  appSalesEnabled Boolean                  @default(false) @map("app_sales_enabled")
  type            String?
  orderPaymentType String?                 @map("order_payment_type")
  background      String?
  bgImageUrl      String?                  @map("bg_image_url")
  bgImageWidth    Int?                     @map("bg_image_width")
  bgImageHeight   Int?                     @map("bg_image_height")
  slug            String?
  paymentProvider String                   @default("mollie") @map("payment_provider")
  noShowDeadlineMinutes Int?                @map("no_show_deadline_minutes")
  features        String[]                 @default(["sunbeds"])
  /// Sunbed reservations are unit-granular by default: a guest books a whole
  /// SunbedGroup (the beds standing together under one parasol), never a part
  /// of it. With this on, any subset of a unit — down to a single seat — is
  /// bookable, in all three flows (online, venue/POS, on-site manage grid).
  /// Opt-in per site, because splitting a unit means a stranger can end up on
  /// the neighbouring bed, which many venues sell against.
  partialGroupBookingEnabled Boolean         @default(false) @map("partial_group_booking_enabled")
  /// Track 023 — this site renders a BESPOKE brand page instead of the standard
  /// branded one at `/s/{slug}`. Admin-only: bespoke work is platform-delivered,
  /// not partner-configurable.
  ///
  /// It is one of TWO gates, and it deliberately cannot act alone. The other is
  /// a per-site React module registered in `apps/user/brands`. The registry
  /// answers "does a bespoke page EXIST"; this column answers "is it LIVE" — so
  /// a merged page can sit dark until the customer approves it, and a broken one
  /// can be pulled without a revert and a deploy.
  ///
  /// On alone (no module) the standard page renders, deliberately: a bespoke
  /// page failing must cost the customer their design, not their bookings.
  customBrandEnabled Boolean               @default(false) @map("custom_brand_enabled")
  /// Track 023 — WHICH bespoke brand module renders this site, e.g. `alcudia`.
  ///
  /// Not `Site.code`, and not the slug. The code is minted per DATABASE, so the
  /// same venue carries different codes in dev, test and production — a registry
  /// committed against one of them would resolve nowhere else, including the
  /// Vercel previews that run on the test DB. The slug is partner-editable. This
  /// column is the join instead: the key lives in code (a directory under
  /// `apps/user/brands`), and each environment's row points at it.
  ///
  /// Nullable: most sites have no bespoke module. A key that matches nothing in
  /// the registry resolves to the standard page, exactly like `enabled` off.
  customBrandKey  String?                  @map("custom_brand_key")
  layoutMode      String                   @default("geo") @map("layout_mode")
  layoutWidth     Float?                   @map("layout_width")
  layoutHeight    Float?                   @map("layout_height")
  // Soft link to a Restaurant for chiringuitos. No Prisma relation declared —
  // plain column with FK constraint at the DB level only (see migration SQL).
  // Kept soft to preserve a clean extraction path if the restaurant product
  // ever needs its own database.
  restaurantId    String?                  @unique @map("restaurant_id")
  // IANA timezone (e.g. "Europe/Madrid") for this venue. Null = derive from
  // locationLat/locationLng via tz-lookup at read time. See src/site-day.ts.
  timeZone        String?                  @map("time_zone")

  inventoryItems  InventoryItem[]
  layoutElements  LayoutElement[]
  orders          Order[]
  products        Product[]
  rentalItems     RentalItem[]
  rentalBookings  RentalBooking[]
  reservations    Reservation[]
  serviceFees     ServiceFee[]
  settlements     Settlement[]
  sunbedGroups    SunbedGroup[]
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workingHours    SiteWorkingHours[]
  brand           SiteBrand?
  tillCloses      TillClose[]
  tillEntries     TillEntry[]
  tableTabs       TableTab[]

  @@index([coords], map: "site_coords_idx", type: Gist)
}

model SiteBrand {
  id              String                   @id @unique @default(cuid())
  siteId          String                   @map("site_id") @unique
  brandName       String
  tagline         String?
  primaryColor    String?                  @map("primary_color")
  accentColor     String?                  @map("accent_color")
  bgColor         String?                  @map("bg_color")
  fgColor         String?                  @map("fg_color")
  logoUrl         String?                  @map("logo_url")
  bgImageUrl      String?                  @map("bg_image_url")
  bgImageWidth    Int?                     @map("bg_image_width")
  bgImageHeight   Int?                     @map("bg_image_height")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteWorkingHours {
  id        String   @id @unique @default(cuid())
  siteId    String   @map("site_id")
  day       Int
  openTime  DateTime @map("open_time")
  closeTime DateTime @map("close_time")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id             String         @id @unique @default(cuid())
  userId         String         @map("user_id")
  siteId         String         @map("site_id")
  number         Int
  locationLat    String         @map("location_lat")
  locationLng    String         @map("location_lng")
  schematicX     Float?         @map("schematic_x")
  schematicY     Float?         @map("schematic_y")
  status         String
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  image          String?
  label          String?
  rotation       Int?
  category       String?
  price          Float?
  /// Track 021 — LEGACY, retired, dropped in a later release.
  ///
  /// Superseded by `SunbedGroup`: every row carrying one points at a seat in its
  /// OWN unit (verified across environments), so it holds nothing the unit does
  /// not. Nothing reads it. The self-relation was dropped this release; the
  /// COLUMN stays one release longer because deployed code still writes
  /// `pairId: null`, and `main` and `test` share one database.
  pairId         String?        @unique @map("pair_id")
  group          Int            @default(0)
  itemGroupId    String?        @map("item_group_id")
  sunbedGroupId  String?        @map("sunbed_group_id")
  seatLabel      String?        @map("seat_label")
  itemGroup      ItemGroup?     @relation(fields: [itemGroupId], references: [id])
  sunbedGroup    SunbedGroup?   @relation(fields: [sunbedGroupId], references: [id])
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  reservations   Reservation[]  @relation("InventoryItemToReservation")

  // Track 020 P1. Postgres does NOT auto-index foreign keys, so before these
  // every `where: { siteId }` was a sequential scan of the whole table across
  // ALL tenants — a small venue paid for a large one's rows.
  //
  // Both are composites with `site_id` leading, so they also serve plain
  // site-scoped lookups; a separate `@@index([siteId])` measured as redundant
  // and was left out rather than carried as write amplification. `(siteId,
  // status)` was also measured and REJECTED — `status = 'active'` matches ~99%
  // of a site's seats, so it is not selective enough to earn its cost.
  // Benchmarked via `npm run scale:bench` (packages/data/scripts).
  @@index([siteId, group])  // parcel ops: moveParcel, deleteItemsByGroup (39x)
  @@index([siteId, number]) // next-seat-number lookup + ordered site load (79x)
}

model SunbedGroup {
  id        String          @id @unique @default(cuid())
  siteId    String          @map("site_id")
  /// Track 021 P3 — the unit's PERSISTED ordinal within its (parcel, row).
  /// Seat labels read `{parcel}-{row}{seq:02}-{member}`; deriving `seq` from
  /// left-to-right position meant inserting or removing one unit silently
  /// renamed every unit to its right, while the painted number on the bed did
  /// not move. Nullable during expand: units created before this get their seq
  /// from the existing positional order, so no label changes on release.
  seq       Int?
  /// Track 021 — the rest of the unit's ADDRESS, completing `seq`.
  ///
  /// Position is the identity (see the track's paradigm section): a unit is
  /// "the sunbeds standing at this spot", and `{parcel}-{row}-{seq}` names the
  /// spot. Before this, only `seq` lived here — parcel came from
  /// `InventoryItem.group` and row was decoded out of `InventoryItem.number`,
  /// so two-thirds of a unit's address lived on its members. That made the
  /// address unconstrainable (no unique index can span two tables), made
  /// resolving one a parcel-wide fetch plus a JS filter, and let a seat
  /// renumber silently re-point a device bound to the old address.
  ///
  /// Derived from the unit's PLACED seats only. `pool` extras carry synthetic
  /// numbers from `nextPoolNumber` that decode to a different row than the unit
  /// they hang off, so including them makes the address ambiguous — verified
  /// against real data before this shipped.
  ///
  /// Nullable during expand, and permanently null for a unit holding no placed
  /// seat (no physical position to name). Written ONLY by `recomputeSeatLabels`.
  parcel    Int?
  row       Int?            @map("row_idx")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items     InventoryItem[]

  /// Two units cannot occupy one spot. Enforced rather than merely observed:
  /// the property held for all 3,096 units across local/test/production when
  /// this was added, but nothing was stopping it from breaking.
  ///
  /// Postgres treats NULLs as distinct here, so a unit with no address (no
  /// placed seats) never collides — which is also why this index can be created
  /// BEFORE the backfill populates the columns.
  @@unique([siteId, parcel, row, seq])
}

model ItemGroup {
  id            String          @id @unique @default(cuid())
  number        Int
  label         String?
  rows          Int
  seatsPerRow   Int             @map("seats_per_row")
  locationLat   String          @map("location_lat")
  locationLng   String          @map("location_lng")
  schematicX    Float?          @map("schematic_x")
  schematicY    Float?          @map("schematic_y")
  status        String          @default("active")
  rotation      Int             @default(0)
  horizontalGap Float           @map("horizontal_gap")
  verticalGap   Float           @map("vertical_gap")
  pairGap       Float           @map("pair_gap")
  category      String?
  price         Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         InventoryItem[]
}

model LayoutElement {
  id        String   @id @default(cuid())
  // Exactly one of siteId or restaurantId must be set (enforced by a CHECK
  // constraint in the migration SQL — Prisma itself cannot express an XOR).
  siteId       String?  @map("site_id")
  restaurantId String?  @map("restaurant_id")
  type      String
  shape     String
  x         Float
  y         Float
  width     Float
  height    Float
  rotation  Float    @default(0)
  z         Int      @default(0)
  label        String?
  color        String?
  cornerRadius Float?   @default(0) @map("corner_radius")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  site         Site?       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([restaurantId])
  @@map("layout_element")
}

model Reservation {
  id                String          @id @unique @default(cuid())
  userId            String          @map("user_id")
  siteId            String          @map("site_id")
  itemId            String?         @map("item_id")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  status            String          @default("pending")
  operationalStatus String          @default("expected") @map("operational_status")
  isComp            Boolean         @default(false) @map("is_comp")
  refundedAt        DateTime?       @map("refunded_at")
  type              String          @default("hours")
  from              DateTime        @map("from")
  to                DateTime        @map("to")
  paymentAmount     Float?          @map("payment_amount")
  paymentRef        String?         @map("payment_ref")
  anonId            String?         @map("anon_id")
  checkedInAt       DateTime?       @map("checked_in_at")
  departedAt        DateTime?       @map("departed_at")
  guestName         String?         @map("guest_name")
  guestContact      String?         @map("guest_contact")
  guestEmail        String?         @map("guest_email")
  internalNotes     String?         @map("internal_notes")
  reminderSentAt    DateTime?       @map("reminder_sent_at")
  employeeId        String?         @map("employee_id")
  // Split lineage (track 018): when a subset of seats is peeled into a new
  // reservation (depart-split / seat-collect / hold-convert), the new row points
  // at its origin. Conservation invariants (I1 till, I2 receipts) are checked
  // across a lineage, and audit can walk a party's full history. SetNull: a
  // deleted origin (only ever a zero-money row, I4) must not orphan-cascade.
  splitFromId       String?         @map("split_from_id")
  splitFrom         Reservation?    @relation("ReservationSplitLineage", fields: [splitFromId], references: [id], onDelete: SetNull)
  splitInto         Reservation[]   @relation("ReservationSplitLineage")
  orders            Order[]
  invoices          Invoice[]
  days              ReservationDay[]
  tillEntries       TillEntry[]
  site              Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee          Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  items             InventoryItem[] @relation("InventoryItemToReservation")

  // Track 020 P1 — the single highest-value index in the schema.
  //
  // `Reservation` is the table that accumulates forever: every booking at every
  // venue. Every hot read is "this site, overlapping this window" — consumer
  // availability, the manage grid, accounting, analytics — and each was a full
  // sequential scan. Measured at 441k rows: overlap window 180ms → 2.1ms (84x),
  // month revenue 234ms → 2.7ms (87x).
  //
  // The sharpest one is `findConflictingReservation` (src/reservations.ts),
  // which runs this shape INSIDE the booking transaction's `SELECT … FOR
  // UPDATE`: 256ms → 1.0ms (261x). That is 256ms of lock hold per booking
  // removed, on the path that serialises concurrent bookings for the same
  // seats — i.e. it mattered most exactly when the venue was busiest.
  @@index([siteId, from, to])
}

model ReservationDay {
  id                String      @id @default(cuid())
  reservationId     String      @map("reservation_id")
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  // Civil calendar date (no time/tz component) — stored as DATE in Postgres.
  date              DateTime    @db.Date
  // Operational status for this specific day. Reuses OP_* constants from
  // src/reservation-status.ts (expected / checked-in / walked-in / departed /
  // no-show / comp). String column — NOT a Prisma enum (per repo convention).
  // Note: operational status now lives BOTH on Reservation (legacy, whole-stay)
  // and on ReservationDay (per-day, P0 addition). The per-day row is authoritative
  // for P1+ read paths; the parent fields stay in parallel-write until P4 contract.
  operationalStatus String      @default("expected") @map("operational_status")
  checkedInAt       DateTime?   @map("checked_in_at")
  departedAt        DateTime?   @map("departed_at")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([reservationId, date])
  @@index([date])
  @@map("reservation_day")
}

model Product {
  id          String   @id @unique @default(cuid())
  name        String
  description String?
  price       Float
  tax         Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  siteId      String   @map("site_id")
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  imageHeight Int?     @map("image_height")
  imageWidth  Int?     @map("image_width")
  category    String?  @default("food")
  soldOut     Boolean  @default(false) @map("sold_out")
  prepTime    Int?     @map("prep_time")
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Order {
  id            String         @id @unique @default(cuid())
  price         Float
  tax           Float
  totalPrice    Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // Nullable since dine-in v2 (owner CHECK order_owner_chk enforces at least
  // one of siteId/restaurantId). Linked-venue dine orders dual-write both;
  // standalone-restaurant orders carry restaurantId only.
  siteId        String?        @map("site_id")
  restaurantId  String?        @map("restaurant_id")
  status        String         @default("created")
  anonId        String?        @map("anon_id")
  paymentAmount Float?         @map("payment_amount")
  paymentRef    String?        @map("payment_ref")
  userId        String         @map("user_id")
  reservationId String?        @map("reservation_id")
  seatId        String?        @map("seat_id")
  // Dine-in tab link. tabId relates to the TableTab that groups this order
  // with other rounds for a single payment. tableId is a denormalized label
  // (no FK relation) for the kitchen/orders dashboard to display the table.
  tabId         String?        @map("tab_id")
  tableId       String?        @map("table_id")
  notes         String?
  rejectReason  String?        @map("reject_reason")
  acceptedAt    DateTime?      @map("accepted_at")
  readyAt       DateTime?      @map("ready_at")
  deliveredAt   DateTime?      @map("delivered_at")
  invoices      Invoice[]
  reservation   Reservation?   @relation(fields: [reservationId], references: [id])
  seat          InventoryItem? @relation(fields: [seatId], references: [id])
  tab           TableTab?      @relation(fields: [tabId], references: [id])
  site          Site?          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([restaurantId])
}

model OrderItem {
  id         String   @id @unique @default(cuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  price      Float
  tax        Float
  totalPrice Float
  notes      String?
  category   String?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String         @id @unique @default(cuid())
  accountId    String         @map("account_id")
  status       String         @default("created")
  paymentRef   String?        @map("payment_ref")
  totalCharge  Float          @map("total_charge")
  totalTax     Float          @default(0) @map("total_tax")
  totalAmount  Float          @map("total_amount")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  invoicedAt       DateTime          @default(now()) @map("invoiced_at")
  issuerType       String            @default("PARTNER") @map("issuer_type")
  issuerVatNumber  String?           @map("issuer_vat_number")
  issuerCompanyName   String?        @map("issuer_company_name")
  issuerCompanyAddress String?       @map("issuer_company_address")
  // Bill-to party. Populated on the PLATFORM (B2B commission) invoice, whose
  // recipient is the partner. Null on PARTNER invoices (consumer sale / simplified receipt).
  recipientCompanyName    String?    @map("recipient_company_name")
  recipientVatNumber      String?    @map("recipient_vat_number")
  recipientCompanyAddress String?    @map("recipient_company_address")
  // EU B2B reverse charge: when set, the issuer charged 0 VAT and the recipient
  // self-accounts. Used on cross-border PLATFORM commission invoices.
  reverseCharge    Boolean           @default(false) @map("reverse_charge")
  // Mollie (or other PSP) processing fee for this payment, captured for partner
  // reconciliation. VAT-exempt — not part of the invoice VAT total. Populated by
  // the settlement-sync step (deferred); null until captured.
  processingFee    Float?            @map("processing_fee")
  settlementId     String?           @map("settlement_id")
  settlementBatchId String?          @map("settlement_batch_id")
  reservationId    String?           @map("reservation_id")
  orderId          String?           @map("order_id")
  // Table-reservation deposit invoice link (no-show deposit cascade).
  tableReservationId String?         @map("table_reservation_id")
  // Dine-in tab invoice link — idempotency anchor for processConfirmedTabPayment.
  // Mirrors the tableReservationId precedent (chunk 1e).
  tableTabId         String?         @map("table_tab_id")
  invoiceNumber    String?           @unique @map("invoice_number")
  previousHash     String?           @map("previous_hash")
  hash             String?
  // Credit-note link (track 018 P2d / track 015 deferred): a credit note is an
  // Invoice with negative totals whose creditsInvoiceId points at the original
  // receipt it rectifies. Own number series (PARTNER-CN-YYYY-NNNNN), same
  // issuer hash chain. Invoices are never deleted (hash chain), so SetNull is
  // a formality.
  creditsInvoiceId String?           @map("credits_invoice_id")
  creditsInvoice   Invoice?          @relation("InvoiceCreditNote", fields: [creditsInvoiceId], references: [id], onDelete: SetNull)
  creditNotes      Invoice[]         @relation("InvoiceCreditNote")
  // Product discriminator. Brand-neutral values: "beachclub" for sunbed / F&B
  // order / rental invoices, "restaurant" for (future) table-reservation
  // invoices. Default preserves existing behaviour for code that doesn't set
  // it explicitly.
  product          String            @default("beachclub") @map("product")
  account          PartnerAccount    @relation(fields: [accountId], references: [userId], onDelete: Cascade)
  settlementBatch  Settlement?       @relation(fields: [settlementBatchId], references: [id])
  reservation      Reservation?      @relation(fields: [reservationId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  tableReservation TableReservation? @relation(fields: [tableReservationId], references: [id])
  tableTab         TableTab?         @relation(fields: [tableTabId], references: [id])
  invoiceLines     InvoiceLine[]

  @@index([tableReservationId])
  @@index([tableTabId])
  @@index([creditsInvoiceId])
}

model Settlement {
  id             String           @id @default(cuid())
  accountId      String           @map("account_id")
  siteId         String           @map("site_id")
  periodStart    DateTime         @map("period_start")
  periodEnd      DateTime         @map("period_end")
  grossRevenue   Float            @map("gross_revenue")
  totalTax       Float            @default(0) @map("total_tax")
  commission     Float
  netPayout      Float            @map("net_payout")
  currency       String           @default("EUR")
  status         SettlementStatus @default(DRAFT)
  bankReference  String?          @map("bank_reference")
  paidAt         DateTime?        @map("paid_at")
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // Product discriminator (see Invoice.product).
  product        String           @default("beachclub") @map("product")
  account        PartnerAccount   @relation(fields: [accountId], references: [userId])
  site           Site             @relation(fields: [siteId], references: [id])
  invoices       Invoice[]
}

model InvoiceLine {
  id          String   @id @unique @default(cuid())
  invoiceId   String   @map("invoice_id")
  charge      Float
  tax         Float    @default(0)
  amount      Float
  vatRate     Float?   @map("vat_rate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  productCode String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model SecurityToken {
  id        String   @id @unique @default(cuid())
  expires   DateTime
  resources String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @map("user_id")
}

model RentalItem {
  id            String          @id @unique @default(cuid())
  siteId        String          @map("site_id")
  name          String
  description   String?
  imageUrl      String?         @map("image_url")
  category      String?
  pricePerHour  Float?          @map("price_per_hour")
  pricePerDay   Float?          @map("price_per_day")
  totalQuantity Int             @default(1) @map("total_quantity")
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  site          Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  bookings      RentalBooking[]
}

model RentalBooking {
  id                String     @id @unique @default(cuid())
  siteId            String     @map("site_id")
  rentalItemId      String     @map("rental_item_id")
  userId            String     @map("user_id")
  from              DateTime
  to                DateTime
  quantity          Int        @default(1)
  durationType      String     @default("hours") @map("duration_type")
  totalPrice        Float      @map("total_price")
  status            String     @default("pending")
  operationalStatus String     @default("reserved") @map("operational_status")
  guestName         String?    @map("guest_name")
  paymentRef        String?    @map("payment_ref")
  paymentAmount     Float?     @map("payment_amount")
  pickedUpAt        DateTime?  @map("picked_up_at")
  returnedAt        DateTime?  @map("returned_at")
  anonId            String?    @map("anon_id")
  guestEmail        String?    @map("guest_email")
  guestContact      String?    @map("guest_contact")
  reminderSentAt    DateTime?  @map("reminder_sent_at")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  employeeId        String?    @map("employee_id")
  site              Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rentalItem        RentalItem  @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee          Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  tillEntries       TillEntry[]
}

// Floor-staff roster — scoped to the PartnerAccount (workers rotate across a
// partner's sites). Attribution only; authorization stays on the SecurityToken.
model Employee {
  id             String          @id @default(cuid())
  accountId      String          @map("account_id")
  name           String
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  account        PartnerAccount  @relation(fields: [accountId], references: [userId], onDelete: Cascade)
  reservations   Reservation[]
  rentalBookings RentalBooking[]
  tillCloses     TillClose[]
  tillEntries    TillEntry[]

  @@index([accountId])
}

// A shift-close reconciliation snapshot: cash a worker handed in at a site.
// The "open till" is cash attributed to the worker at the site since their last
// close; this row marks the boundary (persists — Sunbnb never day-resets).
model TillClose {
  id              String   @id @default(cuid())
  siteId          String   @map("site_id")
  employeeId      String   @map("employee_id")
  closedAt        DateTime @default(now()) @map("closed_at")
  totalAmount     Float    @map("total_amount")
  txnCount        Int      @map("txn_count")
  // Day-anchored till (track 016): the portion of totalAmount/txnCount that was
  // carried over from before the venue-local day start (unclosed prior-day cash
  // swept in by this close). Nullable — populated by new-model writers
  // (closeEmployeeTill); historical rows predating the rework leave these null.
  carryOverAmount Float?   @map("carry_over_amount")
  carryOverCount  Int?     @map("carry_over_count")
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([siteId, employeeId])
}

// An explicit ledger entry recording cash taken at the till for a reservation.
// Decouples "money collected" from "guest occupancy state" so the till is not
// distorted by operational-status changes, departures, or seat turnover.
// Voiding (voidedAt) records that cash LEFT the drawer (refund / return).
// onDelete: SetNull on reservation — an unreserve deletes the reservation but a
// forfeited/retained settlement must persist and keep counting.
model TillEntry {
  id               String        @id @default(cuid())
  siteId           String        @map("site_id")
  reservationId    String?       @map("reservation_id")
  rentalBookingId  String?       @map("rental_booking_id")
  employeeId       String?       @map("employee_id")
  amount           Float
  settledAt        DateTime      @map("settled_at")
  voidedAt         DateTime?     @map("voided_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  site             Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reservation      Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  rentalBooking    RentalBooking? @relation(fields: [rentalBookingId], references: [id], onDelete: SetNull)
  employee         Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([siteId, employeeId, settledAt])
  @@index([reservationId])
  @@index([rentalBookingId])
  @@map("till_entry")
}

// ═══════════════════════════════════════════════════════════════════════════
// Restaurants, tables, menu, table reservations
//
// All models in this section belong to the standalone restaurant product
// (currently branded "tablefind"). Cross-product links (Site.restaurantId)
// are declared without Prisma relations on the sunbnb side to keep the
// extraction path clean. Brand-neutral naming throughout so the brand can
// change without touching schema or migrations.
// ═══════════════════════════════════════════════════════════════════════════

model Restaurant {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  name                  String
  tagline               String?
  description           String?
  partnerAccountId      String              @map("partner_account_id")
  // Optional soft link to a Sunbnb Site for chiringuitos. Plain FK at the
  // DB level; no Prisma relation on the Site side (see Site.restaurantId).
  siteId                String?             @unique @map("site_id")
  cuisineType           String?             @map("cuisine_type")
  priceRange            Int?                @map("price_range")            // 1..4
  averageMealDuration   Int                 @default(120) @map("average_meal_duration")
  reservationWindow     Int                 @default(60)  @map("reservation_window")
  // IANA timezone (e.g. "Europe/Madrid") the venue's working hours and slot
  // wall-clock times are interpreted in. Null falls back to a default in the
  // availability engine — the server process TZ must never be used for slot math.
  timeZone              String?             @map("time_zone")
  // No-show protection. "none" = free bookings (default). "deposit" = a
  // per-guest deposit is required for shifts/parties that opt in (per-shift
  // `requiresDeposit` + `depositMinPartySize`). Consumer-paid via the apps.
  noShowPolicy          String              @default("none") @map("no_show_policy")
  depositPerGuest       Float?              @map("deposit_per_guest")
  // Hours before a reservation's start that a guest may still cancel/modify
  // online. Null = no restriction. A timely (before-deadline) cancel refunds the
  // deposit; a late cancel forfeits it; modify is blocked within the deadline.
  cancellationDeadlineHours Int?            @map("cancellation_deadline_hours")
  layoutWidth           Float?              @map("layout_width")
  layoutHeight          Float?              @map("layout_height")
  // If false, chiringuito-linked restaurants stay hidden from tablefind.app's
  // public listing. Always discoverable on Sunbnb. Brand-neutral column name
  // so the standalone brand can change.
  publicOnStandaloneApp Boolean             @default(true) @map("public_on_standalone_app")
  // Master switch for guest table-selection ("pick your spot"). When false
  // (default) the consumer never sees the floor map and tables are auto-assigned.
  // When true, tables individually flagged `Table.guestSelectable` become
  // guest-pickable from the read-only floor map. Opt-in, never the default.
  guestSelectionEnabled Boolean             @default(false) @map("guest_selection_enabled")
  // Master switch for QR dine-in tab ordering (v2: the single gate for both
  // standalone and site-linked restaurants; Site.appSalesEnabled now governs
  // sunbed room-service only). Backfilled true for linked venues whose site
  // had appSalesEnabled at migration time.
  dineInEnabled         Boolean             @default(false) @map("dine_in_enabled")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  partnerAccount        PartnerAccount      @relation(fields: [partnerAccountId], references: [userId], onDelete: Cascade)
  tables                Table[]
  reservations          TableReservation[]
  menuItems             MenuItem[]
  workingHours          RestaurantHours[]
  shifts                RestaurantShift[]
  combinations          TableCombination[]
  waitlistEntries       TableWaitlistEntry[]
  layoutElements        LayoutElement[]
  tabs                  TableTab[]
  orders                Order[]

  @@index([partnerAccountId])
  @@map("restaurant")
}

model Table {
  id             String              @id @default(cuid())
  restaurantId   String              @map("restaurant_id")
  number         Int
  label          String?
  capacity       Int
  minPartySize   Int                 @default(1) @map("min_party_size")
  // Cap above which a party should be steered to a larger table even if the
  // physical capacity allows. Null = no upper bound beyond `capacity`.
  maxPartySize   Int?                @map("max_party_size")
  shape          String              @default("square")   // "square" | "round" | "rect" | "oval" | "booth" | "bar"
  // Physical footprint in metres. Explicit per-table so a 2-top renders
  // smaller than an 8-top. Defaults are a reasonable 4-seater — callers that
  // care (palette presets, grid generator) always pass concrete values.
  width          Float               @default(1.2)
  height         Float               @default(1.2)
  schematicX     Float?              @map("schematic_x")
  schematicY     Float?              @map("schematic_y")
  rotation       Float               @default(0)
  status         String              @default("active")   // "active" | "inactive"
  // Optional section grouping ("Terrace", "Indoor", "Bar").
  zone           String?
  // Partner-internal note shown on the reservation row when seating guests.
  // Never visible to the customer.
  staffNote      String?             @map("staff_note")
  // When false, the table is reserved for walk-ins / staff seating only and
  // never surfaces in the consumer availability search.
  onlineBookable Boolean             @default(true) @map("online_bookable")
  // Eligible to be joined into a TableCombination for larger parties.
  combinable     Boolean             @default(false)
  // "Pick your spot": when true (and the restaurant's guestSelectionEnabled
  // master switch is on), this table is guest-pickable from the consumer floor
  // map. Gate to a premium/view subset — never the whole floor.
  guestSelectable Boolean            @default(false) @map("guest_selectable")
  // Booking-relevant attributes (validated allowed set in core): "accessible",
  // "window", "outdoor", "high_top", "communal", "quiet". Section = `zone`.
  features       String[]            @default([])
  // Per-table no-show deposit override (chunk 1e). `requiresDeposit`: null =
  // inherit the shift's gate; true = always require (ignores shift + min party);
  // false = exempt this table. `depositPerGuest`: null = inherit
  // Restaurant.depositPerGuest; else this per-guest amount. Both gated by the
  // restaurant-level noShowPolicy master switch.
  requiresDeposit Boolean?           @map("requires_deposit")
  depositPerGuest Float?             @map("deposit_per_guest")
  // Per-table override of `Restaurant.averageMealDuration`. Null inherits.
  turnTimeMinutes Int?               @map("turn_time_minutes")
  // Editor-only flag: prevents accidental drag/resize on the floor plan.
  locked         Boolean             @default(false)
  // Optional per-side chair-count override. Null on all four = auto-distribute
  // by capacity (default). When any is non-null, the renderer uses these
  // counts directly; their sum is validated to equal `capacity`.
  seatsTop       Int?                @map("seats_top")
  seatsRight     Int?                @map("seats_right")
  seatsBottom    Int?                @map("seats_bottom")
  seatsLeft      Int?                @map("seats_left")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations   TableReservation[]
  tableTabs      TableTab[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@map("restaurant_table")
}

model TableReservation {
  id                String      @id @default(cuid())
  restaurantId      String      @map("restaurant_id")
  tableId           String?     @map("table_id")          // optional; may be assigned at check-in
  userId            String?     @map("user_id")
  anonId            String?     @map("anon_id")
  from              DateTime
  to                DateTime
  partySize         Int         @map("party_size")
  status            String      @default("confirmed")     // confirmed | canceled
  operationalStatus String      @default("expected") @map("operational_status")
                                                          // expected | seated | departed | no_show
  // When a large party books a TableCombination, one TableReservation row is
  // created per member table, all sharing this group id (cancel/seat operate on
  // the group). Null for ordinary single-table bookings.
  bookingGroupId    String?     @map("booking_group_id")
  // No-show deposit (chunk 1e). depositAmount = required deposit (null = free);
  // depositStatus = none|pending|held|charged|refunded|released; paymentRef is
  // the Stripe/Mollie/demo reference once a deposit is collected by the app.
  depositAmount     Float?      @map("deposit_amount")
  depositStatus     String?     @map("deposit_status")
  paymentRef        String?     @map("payment_ref")
  guestName         String      @map("guest_name")
  guestEmail        String      @map("guest_email")
  guestPhone        String?     @map("guest_phone")
  specialRequests   String?     @map("special_requests")
  internalNotes     String?     @map("internal_notes")
  seatedAt          DateTime?   @map("seated_at")
  departedAt        DateTime?   @map("departed_at")
  reminderSentAt    DateTime?   @map("reminder_sent_at")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table             Table?      @relation(fields: [tableId], references: [id])
  user              User?       @relation(fields: [userId], references: [id])
  invoices          Invoice[]

  @@index([restaurantId, from])
  @@index([tableId, from, to])
  @@index([bookingGroupId])
  @@map("table_reservation")
}

// A predefined joinable set of tables for large parties (the OpenTable /
// SevenRooms model). All member tables must have `combinable = true`. Booking a
// combination creates one TableReservation per member sharing a bookingGroupId.
model TableCombination {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  name         String?
  capacity     Int                                  // combined seating
  tableIds     String[]   @map("table_ids")         // member Table ids
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("table_combination")
}

// A guest waiting for an opening on a given day. When a reservation frees
// capacity, the earliest matching waiting entry is auto-notified by the apps.
model TableWaitlistEntry {
  id            String     @id @default(cuid())
  restaurantId  String     @map("restaurant_id")
  dateISO       String     @map("date_iso")          // venue civil date "YYYY-MM-DD"
  requestedTime String?    @map("requested_time")     // "HH:mm" preference, optional
  partySize     Int        @map("party_size")
  guestName     String     @map("guest_name")
  guestEmail    String     @map("guest_email")
  guestPhone    String?    @map("guest_phone")
  status        String     @default("waiting")        // waiting | notified | converted | expired
  notifiedAt    DateTime?  @map("notified_at")
  userId        String?    @map("user_id")
  anonId        String?    @map("anon_id")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, dateISO, status])
  @@map("table_waitlist_entry")
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  name         String
  description  String?
  // VAT triple (mirrors Product): partner enters the gross `totalPrice` +
  // `tax` (VAT %); `price` is the derived net base via reverse VAT. Rows
  // created before dine-in v2 have tax=0 and total_price backfilled = price.
  price        Float
  tax          Float       @default(0)
  totalPrice   Float       @default(0) @map("total_price")
  imageUrl     String?     @map("image_url")
  category     String      @default("main")
  soldOut      Boolean     @default(false) @map("sold_out")
  active       Boolean     @default(true)
  displayOrder Int         @default(0) @map("display_order")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("menu_item")
}

model RestaurantHours {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  day          Int                                         // 0 (Sun) .. 6 (Sat)
  openTime     String      @map("open_time")               // "HH:mm"
  closeTime    String      @map("close_time")              // "HH:mm"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_hours")
}

// Named service shift (e.g. Lunch, Dinner) for a weekday. When a restaurant has
// shifts for a day, the availability engine uses them instead of RestaurantHours
// (which it falls back to when there are none). Shifts add pacing — a cap on the
// covers (summed party size) that may *start* within each pacing window.
model RestaurantShift {
  id                      String     @id @default(cuid())
  restaurantId            String     @map("restaurant_id")
  name                    String
  day                     Int                                 // 0 (Sun) .. 6 (Sat)
  startTime               String     @map("start_time")       // "HH:mm"
  endTime                 String     @map("end_time")         // "HH:mm"
  // Max covers (sum of party sizes) that may start in one pacing window. Null =
  // unlimited (no pacing on this shift).
  pacingCovers            Int?       @map("pacing_covers")
  pacingWindowMinutes     Int        @default(15) @map("pacing_window_minutes")
  // Latest booking start before the shift ends, as minutes-before-end. Null =
  // only bounded by the meal fitting before end.
  lastSeatingOffsetMinutes Int?      @map("last_seating_offset_minutes")
  // No-show deposit gate (consumed in chunk 1e). When true, this shift requires
  // a deposit for parties ≥ depositMinPartySize.
  requiresDeposit         Boolean    @default(false) @map("requires_deposit")
  depositMinPartySize     Int?       @map("deposit_min_party_size")
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  restaurant              Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, day])
  @@map("restaurant_shift")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// A flag decided PER CUSTOMER (track 021 P5). Global flags answer "does this
/// feature exist yet"; this answers "does THIS operator have it" — which is the
/// real question for something like devices, where one customer has hardware and
/// the rest do not. Beats the global row, loses to an env override and to sudo.
model AccountFeatureFlag {
  accountId String   @map("account_id")
  name      String
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@id([accountId, name])
  @@map("account_feature_flag")
}

/// A platform-wide PREFERENCE — one tunable scalar the platform operator sets in
/// the admin app, instead of it living as a constant in a deployed source file.
/// Sibling of `FeatureFlag`: that one answers "does this feature exist", this one
/// answers "with what value does it run". Same shape for the same reason — a
/// registry in `@repo/data/preferences` is the source of truth for which keys
/// exist, their type, bounds and default; a row here is only an OVERRIDE, so a
/// key that no longer exists in the registry is inert rather than load-bearing.
/// `value` is stored as text and parsed per the registry entry's type: one table
/// serves every future preference without a migration per setting.
model PlatformPreference {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("platform_preference")
}

model FeatureFlag {
  name        String   @id
  description String
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @map("updated_by")

  @@map("feature_flag")
}

/// Audit + replay-protection record for one impersonation handoff. A row is
/// created when the target app accepts an impersonation token; the unique
/// constraint on `tokenId` (the JTI) makes a second consumption attempt fail
/// with a unique-constraint violation, which the service translates to a
/// replay error.
model ImpersonationLog {
  id           String    @id @default(cuid())
  adminId      String    @map("admin_id")
  targetUserId String    @map("target_user_id")
  tokenId      String    @unique @map("token_id")
  app          String                                 // 'partner' | 'user'
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  ip           String?
  userAgent    String?   @map("user_agent")

  @@index([adminId, startedAt])
  @@index([targetUserId, startedAt])
  @@map("impersonation_log")
}




// ═══════════════════════════════════════════════════════════════════════════
// Dine-in tab — QR order & pay at the table (P1.5)
//
// A party scans a per-table QR → first order opens the tab (lazy create, no
// DB write on scan) → order rounds accumulate as unpaid Order rows on the tab
// → one pay-at-end Mollie/demo payment closes the tab. V1 rides the existing
// site Order/Product rails (restaurant.siteId chiringuito link required).
// ═══════════════════════════════════════════════════════════════════════════

model TableTab {
  id           String    @id @default(cuid())
  tableId      String    @map("table_id")
  restaurantId String    @map("restaurant_id")
  // Nullable since dine-in v2: linked venues dual-write their siteId so site
  // dashboards/accounting keep working; standalone restaurants leave it NULL.
  siteId       String?   @map("site_id")
  status       String    @default("open") @map("status")
  // Concurrency guard: exactly one OPEN tab per table. Set to `tableId` while
  // the tab is open, NULLed when it closes (paid/settled/discarded) — NULLs
  // never collide, so this plain unique index enforces "one open tab per
  // table" without a partial index (which Prisma can't model and which would
  // leave migrate:check permanently red). placeTabOrder's find-or-create
  // relies on the unique violation: the loser of a concurrent create re-reads
  // and joins the winner's tab. Every tab-closing path MUST null this column
  // in the same update that sets the terminal status.
  openTableId  String?   @unique @map("open_table_id")
  // Opener attribution (mirrors Reservation.anonId / .userId conventions).
  // Plain columns, no FK relations — attribution only, not authorization.
  anonId       String?   @map("anon_id")
  userId       String?   @map("user_id")
  // Payment reference populated when the tab is submitted for payment.
  // Shared across all orders in the tab (mirrors RentalBooking group pattern).
  paymentRef   String?   @map("payment_ref")
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  table        Table      @relation(fields: [tableId], references: [id])
  site         Site?      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  invoices     Invoice[]

  @@index([tableId])
  @@index([siteId])
  @@index([restaurantId])
  @@index([paymentRef])
  @@map("table_tab")
}

/// A parasol-mounted hardware device (track 019 P2) — an ESP32-C6 that polls
/// `/api/hw/{code}/state` and lights an LED bar for the seats under its shade.
///
/// There is deliberately NO token/secret column (track 019 Q9): the endpoint is
/// gated by a soft `User-Agent` client filter, not authentication, because the
/// data behind it is public occupancy. `code` is PUBLIC — it is printed on the
/// device's sticker and routes to the binding; it authenticates nothing.
model Device {
  id         String       @id @default(cuid())
  /// Server-issued, random 6-char Crockford base32. Public, printed on the
  /// sticker. Random not sequential: sequential leaks fleet size.
  code       String       @unique
  /// Provisioning fingerprint for support. MUTABLE — a board swap re-flashes the
  /// same code and changes this. Never treat it as identity (../sunbnb-hw ADR 0003).
  macAddr    String?      @map("mac_addr")
  /// provisioned → active → retired. A failed flash leaves a `provisioned` row,
  /// which is the safe direction (the reverse would be a live device with no row).
  status     String       @default("provisioned")
  /// The customer this device belongs to (flashed permanently at the bench, so
  /// it lands in the right partner's fleet list with no claiming step). A
  /// return or resale is a bulk reflash — accepted, track 021 P5.
  partnerAccountId String?  @map("partner_account_id")
  /// The ASSIGNED location — set from the partner UI, delivered to the device
  /// in the state (poll) response. Resolves to "the unit at this address".
  /// Null = self-registered but not yet assigned.
  assignedSiteId   String?  @map("assigned_site_id")
  assignedParcel   Int?     @map("assigned_parcel")
  assignedRow      Int?     @map("assigned_row")
  assignedSeq      Int?     @map("assigned_seq")
  /// The location the device says it is RUNNING, echoed back in telemetry. The
  /// gap between this and the assigned one is what the fleet UI shows as
  /// "assigned but not yet applied" for a device asleep, out of range or dead.
  reportedLocation String?  @map("reported_location")
  /// Last-values telemetry (track 019 P5 writes these; the P1.5 stub does not).
  fw         String?
  lastSeenAt DateTime?    @map("last_seen_at")
  battMv     Int?         @map("batt_mv")
  rssiDbm    Int?         @map("rssi_dbm")
  /// What the DEVICE claims its customer is, when that disagrees with the row.
  /// Recorded, never acted on: a legitimately reflashed device and a spoofed
  /// claim are indistinguishable from here, and this endpoint has no auth — so
  /// a human resolves the handful of real ones instead of handing an
  /// unauthenticated caller the ability to re-point someone else's hardware.
  claimedPartnerCode String? @map("claimed_partner_code")
  /// Q2 (track 021): the bar's segments run left-to-right from the DEVICE's
  /// point of view, but seats are emitted in seat order — so a device mounted
  /// rotated, or on a row numbered right-to-left, lights the wrong half. This
  /// flips the emitted order. Deliberately SERVER-side: the firmware must not
  /// hold a second opinion about a physical fact, which is the same reason the
  /// state projection is not on the device.
  reverseSegments Boolean @default(false) @map("reverse_segments")
  /// A one-shot command for the device, delivered in the state (poll) response
  /// and EXPIRING on its own — there is no ack channel, so a command that is
  /// never picked up must not linger forever. `identify` flashes the bar so
  /// staff can confirm they assigned the right box before walking away.
  pendingCmd   String?   @map("pending_cmd")
  pendingCmdAt DateTime? @map("pending_cmd_at")
  /// Uptime seconds at last report — a drop means the device rebooted, which is
  /// the cheapest crash signal available. `polls`/`tempC` are accepted and
  /// dropped: no column earns its keep yet.
  upSec      Int?         @map("up_sec")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@map("device")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
