generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum SettlementStatus {
  DRAFT
  CLOSED
  APPROVED
  PAID
}

enum SubscriptionTier {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model SubscriptionPlan {
  id              String           @id @default(cuid())
  tier            SubscriptionTier @unique
  name            String
  monthlyPrice    Float            @map("monthly_price")
  maxSites        Int              @map("max_sites")
  stripeProductId String?          @map("stripe_product_id")
  stripePriceId   String?          @map("stripe_price_id")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  partnerAccountId     String             @unique @map("partner_account_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  partnerAccount       PartnerAccount     @relation(fields: [partnerAccountId], references: [userId], onDelete: Cascade)
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
}

model Settings {
  id             String       @id @default(cuid())
  country        String?
  vat            Float?
  currency       String?
  companyName    String?      @map("company_name")
  companyAddress String?      @map("company_address")
  businessId     String?      @map("business_id")
  vatId          String?      @map("vat_id")
  contactEmail   String?      @map("contact_email")
  contactPhone   String?      @map("contact_phone")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  serviceFees    ServiceFee[]
}

model ServiceCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceFee {
  id               String            @id @default(cuid())
  settingsId       String            @map("settings_id")
  siteId           String?           @map("site_id")
  accountId        String?           @map("account_id")
  subscriptionTier SubscriptionTier? @map("subscription_tier")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  chargeType       String            @map("charge_type")
  feeAmount        Float?            @map("fee_amount")
  percentage       Float?
  serviceCode      String            @map("service_code")
  // Optional product scope. NULL = applies to any product (beachclub or
  // restaurant). "beachclub" or "restaurant" = product-scoped. Brand-neutral
  // values so rebrands don't force a data migration.
  product          String?           @map("product")
  account          PartnerAccount?   @relation(fields: [accountId], references: [userId], onDelete: Cascade)
  settings         Settings          @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  site             Site?             @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model PaymentProcessingFee {
  id          String   @id @default(cuid())
  name        String   @default("Default")
  fixedAmount Float?   @map("fixed_amount")
  percentage  Float?
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String               @id @default(cuid())
  name           String?
  email          String               @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  password       String?
  sudo           Boolean              @default(false)
  accounts       Account[]
  Authenticator  Authenticator[]
  inventoryItems InventoryItem[]
  orders         Order[]
  partnerAccount PartnerAccount?
  passwordResetTokens PasswordResetToken[]
  rentalBookings RentalBooking[]
  reservations   Reservation[]
  sessions       Session[]
  sites          Site[]
  tableReservations TableReservation[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model PartnerAccount {
  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  email       String
  phoneNumber String       @map("phone_number")
  company     String
  websiteUrl  String?      @map("website_url")
  address     String
  city        String?
  postalCode  String?      @map("postal_code")
  country     String?
  bankAccount          String?      @map("bank_account")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  userId               String       @id @unique @map("user_id")
  businessId           String?      @map("business_id")
  mollieProfileId      String?      @map("mollie_profile_id")
  mollieAccessToken    String?      @map("mollie_access_token")
  mollieRefreshToken   String?      @map("mollie_refresh_token")
  mollieTokenExpiresAt DateTime?    @map("mollie_token_expires_at")
  mollieOnboardingStatus String?    @map("mollie_onboarding_status")
  invoices            Invoice[]
  settlements         Settlement[]
  subscription        Subscription?
  customSubscription  CustomSubscription?
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceFees         ServiceFee[]
  restaurants         Restaurant[]
}

model CustomSubscription {
  id               String         @id @default(cuid())
  partnerAccountId String         @unique @map("partner_account_id")
  maxSites         Int?           @map("max_sites")
  notes            String?
  featureOverrides Json?          @map("feature_overrides")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  partnerAccount   PartnerAccount @relation(fields: [partnerAccountId], references: [userId], onDelete: Cascade)
}

model Site {
  id              String                   @id @unique @default(cuid())
  userId          String                   @map("user_id")
  name            String
  locationLat     String                   @map("location_lat")
  locationLng     String                   @map("location_lng")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  description     String?
  image           String?
  coords          Unsupported("geometry")?
  price           Float?
  imageHeight     Int?                     @map("image_height")
  imageWidth      Int?                     @map("image_width")
  services        String[]                 @default([])
  vat             Float?
  rentalVat       Float?                   @map("rental_vat")
  rentalPaymentType String?                @map("rental_payment_type")
  status          String                   @default("active")
  appSalesEnabled Boolean                  @default(false) @map("app_sales_enabled")
  type            String?
  orderPaymentType String?                 @map("order_payment_type")
  background      String?
  bgImageUrl      String?                  @map("bg_image_url")
  bgImageWidth    Int?                     @map("bg_image_width")
  bgImageHeight   Int?                     @map("bg_image_height")
  slug            String?
  paymentProvider String                   @default("mollie") @map("payment_provider")
  noShowDeadlineMinutes Int?                @map("no_show_deadline_minutes")
  features        String[]                 @default(["sunbeds"])
  layoutMode      String                   @default("geo") @map("layout_mode")
  layoutWidth     Float?                   @map("layout_width")
  layoutHeight    Float?                   @map("layout_height")
  // Soft link to a Restaurant for chiringuitos. No Prisma relation declared —
  // plain column with FK constraint at the DB level only (see migration SQL).
  // Kept soft to preserve a clean extraction path if the restaurant product
  // ever needs its own database.
  restaurantId    String?                  @unique @map("restaurant_id")

  inventoryItems  InventoryItem[]
  layoutElements  LayoutElement[]
  orders          Order[]
  products        Product[]
  rentalItems     RentalItem[]
  rentalBookings  RentalBooking[]
  reservations    Reservation[]
  serviceFees     ServiceFee[]
  settlements     Settlement[]
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workingHours    SiteWorkingHours[]
  brand           SiteBrand?

  @@index([coords], map: "site_coords_idx", type: Gist)
}

model SiteBrand {
  id              String                   @id @unique @default(cuid())
  siteId          String                   @map("site_id") @unique
  brandName       String
  tagline         String?
  primaryColor    String?                  @map("primary_color")
  accentColor     String?                  @map("accent_color")
  bgColor         String?                  @map("bg_color")
  fgColor         String?                  @map("fg_color")
  logoUrl         String?                  @map("logo_url")
  bgImageUrl      String?                  @map("bg_image_url")
  bgImageWidth    Int?                     @map("bg_image_width")
  bgImageHeight   Int?                     @map("bg_image_height")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteWorkingHours {
  id        String   @id @unique @default(cuid())
  siteId    String   @map("site_id")
  day       Int
  openTime  DateTime @map("open_time")
  closeTime DateTime @map("close_time")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id           String         @id @unique @default(cuid())
  userId       String         @map("user_id")
  siteId       String         @map("site_id")
  number       Int
  locationLat  String         @map("location_lat")
  locationLng  String         @map("location_lng")
  schematicX   Float?         @map("schematic_x")
  schematicY   Float?         @map("schematic_y")
  status       String
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  image        String?
  label        String?
  rotation     Int?
  category     String?
  price        Float?
  pairId       String?        @unique @map("pair_id")
  group        Int            @default(0)
  itemGroupId  String?        @map("item_group_id")
  itemGroup    ItemGroup?     @relation(fields: [itemGroupId], references: [id])
  pair         InventoryItem? @relation("ItemPair", fields: [pairId], references: [id])
  pairedBy     InventoryItem? @relation("ItemPair")
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]  @relation("InventoryItemToReservation")
}

model ItemGroup {
  id            String          @id @unique @default(cuid())
  number        Int
  label         String?
  rows          Int
  seatsPerRow   Int             @map("seats_per_row")
  locationLat   String          @map("location_lat")
  locationLng   String          @map("location_lng")
  schematicX    Float?          @map("schematic_x")
  schematicY    Float?          @map("schematic_y")
  status        String          @default("active")
  rotation      Int             @default(0)
  horizontalGap Float           @map("horizontal_gap")
  verticalGap   Float           @map("vertical_gap")
  pairGap       Float           @map("pair_gap")
  category      String?
  price         Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         InventoryItem[]
}

model LayoutElement {
  id        String   @id @default(cuid())
  // Exactly one of siteId or restaurantId must be set (enforced by a CHECK
  // constraint in the migration SQL — Prisma itself cannot express an XOR).
  siteId       String?  @map("site_id")
  restaurantId String?  @map("restaurant_id")
  type      String
  shape     String
  x         Float
  y         Float
  width     Float
  height    Float
  rotation  Float    @default(0)
  z         Int      @default(0)
  label        String?
  color        String?
  cornerRadius Float?   @default(0) @map("corner_radius")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  site         Site?       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([restaurantId])
  @@map("layout_element")
}

model Reservation {
  id                String          @id @unique @default(cuid())
  userId            String          @map("user_id")
  siteId            String          @map("site_id")
  itemId            String?         @map("item_id")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  status            String          @default("pending")
  operationalStatus String          @default("expected") @map("operational_status")
  type              String          @default("hours")
  from              DateTime        @map("from")
  to                DateTime        @map("to")
  paymentAmount     Float?          @map("payment_amount")
  paymentRef        String?         @map("payment_ref")
  anonId            String?         @map("anon_id")
  checkedInAt       DateTime?       @map("checked_in_at")
  departedAt        DateTime?       @map("departed_at")
  guestName         String?         @map("guest_name")
  guestContact      String?         @map("guest_contact")
  internalNotes     String?         @map("internal_notes")
  reminderSentAt    DateTime?       @map("reminder_sent_at")
  orders            Order[]
  invoices          Invoice[]
  site              Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             InventoryItem[] @relation("InventoryItemToReservation")
}

model Product {
  id          String   @id @unique @default(cuid())
  name        String
  description String?
  price       Float
  tax         Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  siteId      String   @map("site_id")
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  imageHeight Int?     @map("image_height")
  imageWidth  Int?     @map("image_width")
  category    String?  @default("food")
  soldOut     Boolean  @default(false) @map("sold_out")
  prepTime    Int?     @map("prep_time")
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Order {
  id            String         @id @unique @default(cuid())
  price         Float
  tax           Float
  totalPrice    Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  siteId        String         @map("site_id")
  status        String         @default("created")
  anonId        String?        @map("anon_id")
  paymentAmount Float?         @map("payment_amount")
  paymentRef    String?        @map("payment_ref")
  userId        String         @map("user_id")
  reservationId String?        @map("reservation_id")
  seatId        String?        @map("seat_id")
  notes         String?
  rejectReason  String?        @map("reject_reason")
  acceptedAt    DateTime?      @map("accepted_at")
  readyAt       DateTime?      @map("ready_at")
  deliveredAt   DateTime?      @map("delivered_at")
  invoices      Invoice[]
  reservation   Reservation?   @relation(fields: [reservationId], references: [id])
  seat          InventoryItem? @relation(fields: [seatId], references: [id])
  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
}

model OrderItem {
  id         String   @id @unique @default(cuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  price      Float
  tax        Float
  totalPrice Float
  notes      String?
  category   String?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String         @id @unique @default(cuid())
  accountId    String         @map("account_id")
  status       String         @default("created")
  paymentRef   String?        @map("payment_ref")
  totalCharge  Float          @map("total_charge")
  totalTax     Float          @default(0) @map("total_tax")
  totalAmount  Float          @map("total_amount")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  invoicedAt       DateTime          @default(now()) @map("invoiced_at")
  issuerType       String            @default("PARTNER") @map("issuer_type")
  issuerVatNumber  String?           @map("issuer_vat_number")
  issuerCompanyName   String?        @map("issuer_company_name")
  issuerCompanyAddress String?       @map("issuer_company_address")
  // Bill-to party. Populated on the PLATFORM (B2B commission) invoice, whose
  // recipient is the partner. Null on PARTNER invoices (consumer sale / simplified receipt).
  recipientCompanyName    String?    @map("recipient_company_name")
  recipientVatNumber      String?    @map("recipient_vat_number")
  recipientCompanyAddress String?    @map("recipient_company_address")
  // EU B2B reverse charge: when set, the issuer charged 0 VAT and the recipient
  // self-accounts. Used on cross-border PLATFORM commission invoices.
  reverseCharge    Boolean           @default(false) @map("reverse_charge")
  // Mollie (or other PSP) processing fee for this payment, captured for partner
  // reconciliation. VAT-exempt — not part of the invoice VAT total. Populated by
  // the settlement-sync step (deferred); null until captured.
  processingFee    Float?            @map("processing_fee")
  settlementId     String?           @map("settlement_id")
  settlementBatchId String?          @map("settlement_batch_id")
  reservationId    String?           @map("reservation_id")
  orderId          String?           @map("order_id")
  // Table-reservation deposit invoice link (no-show deposit cascade).
  tableReservationId String?         @map("table_reservation_id")
  invoiceNumber    String?           @unique @map("invoice_number")
  previousHash     String?           @map("previous_hash")
  hash             String?
  // Product discriminator. Brand-neutral values: "beachclub" for sunbed / F&B
  // order / rental invoices, "restaurant" for (future) table-reservation
  // invoices. Default preserves existing behaviour for code that doesn't set
  // it explicitly.
  product          String            @default("beachclub") @map("product")
  account          PartnerAccount    @relation(fields: [accountId], references: [userId], onDelete: Cascade)
  settlementBatch  Settlement?       @relation(fields: [settlementBatchId], references: [id])
  reservation      Reservation?      @relation(fields: [reservationId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  tableReservation TableReservation? @relation(fields: [tableReservationId], references: [id])
  invoiceLines     InvoiceLine[]

  @@index([tableReservationId])
}

model Settlement {
  id             String           @id @default(cuid())
  accountId      String           @map("account_id")
  siteId         String           @map("site_id")
  periodStart    DateTime         @map("period_start")
  periodEnd      DateTime         @map("period_end")
  grossRevenue   Float            @map("gross_revenue")
  totalTax       Float            @default(0) @map("total_tax")
  commission     Float
  netPayout      Float            @map("net_payout")
  currency       String           @default("EUR")
  status         SettlementStatus @default(DRAFT)
  bankReference  String?          @map("bank_reference")
  paidAt         DateTime?        @map("paid_at")
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // Product discriminator (see Invoice.product).
  product        String           @default("beachclub") @map("product")
  account        PartnerAccount   @relation(fields: [accountId], references: [userId])
  site           Site             @relation(fields: [siteId], references: [id])
  invoices       Invoice[]
}

model InvoiceLine {
  id          String   @id @unique @default(cuid())
  invoiceId   String   @map("invoice_id")
  charge      Float
  tax         Float    @default(0)
  amount      Float
  vatRate     Float?   @map("vat_rate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  productCode String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model SecurityToken {
  id        String   @id @unique @default(cuid())
  expires   DateTime
  resources String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @map("user_id")
}

model RentalItem {
  id            String          @id @unique @default(cuid())
  siteId        String          @map("site_id")
  name          String
  description   String?
  imageUrl      String?         @map("image_url")
  category      String?
  pricePerHour  Float?          @map("price_per_hour")
  pricePerDay   Float?          @map("price_per_day")
  totalQuantity Int             @default(1) @map("total_quantity")
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  site          Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  bookings      RentalBooking[]
}

model RentalBooking {
  id                String     @id @unique @default(cuid())
  siteId            String     @map("site_id")
  rentalItemId      String     @map("rental_item_id")
  userId            String     @map("user_id")
  from              DateTime
  to                DateTime
  quantity          Int        @default(1)
  durationType      String     @default("hours") @map("duration_type")
  totalPrice        Float      @map("total_price")
  status            String     @default("pending")
  operationalStatus String     @default("reserved") @map("operational_status")
  guestName         String?    @map("guest_name")
  paymentRef        String?    @map("payment_ref")
  paymentAmount     Float?     @map("payment_amount")
  pickedUpAt        DateTime?  @map("picked_up_at")
  returnedAt        DateTime?  @map("returned_at")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  site              Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rentalItem        RentalItem @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════════════════
// Restaurants, tables, menu, table reservations
//
// All models in this section belong to the standalone restaurant product
// (currently branded "tablefind"). Cross-product links (Site.restaurantId)
// are declared without Prisma relations on the sunbnb side to keep the
// extraction path clean. Brand-neutral naming throughout so the brand can
// change without touching schema or migrations.
// ═══════════════════════════════════════════════════════════════════════════

model Restaurant {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  name                  String
  tagline               String?
  description           String?
  partnerAccountId      String              @map("partner_account_id")
  // Optional soft link to a Sunbnb Site for chiringuitos. Plain FK at the
  // DB level; no Prisma relation on the Site side (see Site.restaurantId).
  siteId                String?             @unique @map("site_id")
  cuisineType           String?             @map("cuisine_type")
  priceRange            Int?                @map("price_range")            // 1..4
  averageMealDuration   Int                 @default(120) @map("average_meal_duration")
  reservationWindow     Int                 @default(60)  @map("reservation_window")
  // IANA timezone (e.g. "Europe/Madrid") the venue's working hours and slot
  // wall-clock times are interpreted in. Null falls back to a default in the
  // availability engine — the server process TZ must never be used for slot math.
  timeZone              String?             @map("time_zone")
  // No-show protection. "none" = free bookings (default). "deposit" = a
  // per-guest deposit is required for shifts/parties that opt in (per-shift
  // `requiresDeposit` + `depositMinPartySize`). Consumer-paid via the apps.
  noShowPolicy          String              @default("none") @map("no_show_policy")
  depositPerGuest       Float?              @map("deposit_per_guest")
  // Hours before a reservation's start that a guest may still cancel/modify
  // online. Null = no restriction. A timely (before-deadline) cancel refunds the
  // deposit; a late cancel forfeits it; modify is blocked within the deadline.
  cancellationDeadlineHours Int?            @map("cancellation_deadline_hours")
  layoutWidth           Float?              @map("layout_width")
  layoutHeight          Float?              @map("layout_height")
  // If false, chiringuito-linked restaurants stay hidden from tablefind.app's
  // public listing. Always discoverable on Sunbnb. Brand-neutral column name
  // so the standalone brand can change.
  publicOnStandaloneApp Boolean             @default(true) @map("public_on_standalone_app")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  partnerAccount        PartnerAccount      @relation(fields: [partnerAccountId], references: [userId], onDelete: Cascade)
  tables                Table[]
  reservations          TableReservation[]
  menuItems             MenuItem[]
  workingHours          RestaurantHours[]
  shifts                RestaurantShift[]
  combinations          TableCombination[]
  waitlistEntries       TableWaitlistEntry[]
  layoutElements        LayoutElement[]

  @@index([partnerAccountId])
  @@map("restaurant")
}

model Table {
  id             String              @id @default(cuid())
  restaurantId   String              @map("restaurant_id")
  number         Int
  label          String?
  capacity       Int
  minPartySize   Int                 @default(1) @map("min_party_size")
  // Cap above which a party should be steered to a larger table even if the
  // physical capacity allows. Null = no upper bound beyond `capacity`.
  maxPartySize   Int?                @map("max_party_size")
  shape          String              @default("square")   // "square" | "round" | "rect" | "oval" | "booth" | "bar"
  // Physical footprint in metres. Explicit per-table so a 2-top renders
  // smaller than an 8-top. Defaults are a reasonable 4-seater — callers that
  // care (palette presets, grid generator) always pass concrete values.
  width          Float               @default(1.2)
  height         Float               @default(1.2)
  schematicX     Float?              @map("schematic_x")
  schematicY     Float?              @map("schematic_y")
  rotation       Float               @default(0)
  status         String              @default("active")   // "active" | "inactive"
  // Optional section grouping ("Terrace", "Indoor", "Bar").
  zone           String?
  // Partner-internal note shown on the reservation row when seating guests.
  // Never visible to the customer.
  staffNote      String?             @map("staff_note")
  // When false, the table is reserved for walk-ins / staff seating only and
  // never surfaces in the consumer availability search.
  onlineBookable Boolean             @default(true) @map("online_bookable")
  // Eligible to be joined into a TableCombination for larger parties.
  combinable     Boolean             @default(false)
  // Booking-relevant attributes (validated allowed set in core): "accessible",
  // "window", "outdoor", "high_top", "communal", "quiet". Section = `zone`.
  features       String[]            @default([])
  // Per-table no-show deposit override (chunk 1e). `requiresDeposit`: null =
  // inherit the shift's gate; true = always require (ignores shift + min party);
  // false = exempt this table. `depositPerGuest`: null = inherit
  // Restaurant.depositPerGuest; else this per-guest amount. Both gated by the
  // restaurant-level noShowPolicy master switch.
  requiresDeposit Boolean?           @map("requires_deposit")
  depositPerGuest Float?             @map("deposit_per_guest")
  // Per-table override of `Restaurant.averageMealDuration`. Null inherits.
  turnTimeMinutes Int?               @map("turn_time_minutes")
  // Editor-only flag: prevents accidental drag/resize on the floor plan.
  locked         Boolean             @default(false)
  // Optional per-side chair-count override. Null on all four = auto-distribute
  // by capacity (default). When any is non-null, the renderer uses these
  // counts directly; their sum is validated to equal `capacity`.
  seatsTop       Int?                @map("seats_top")
  seatsRight     Int?                @map("seats_right")
  seatsBottom    Int?                @map("seats_bottom")
  seatsLeft      Int?                @map("seats_left")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations   TableReservation[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@map("restaurant_table")
}

model TableReservation {
  id                String      @id @default(cuid())
  restaurantId      String      @map("restaurant_id")
  tableId           String?     @map("table_id")          // optional; may be assigned at check-in
  userId            String?     @map("user_id")
  anonId            String?     @map("anon_id")
  from              DateTime
  to                DateTime
  partySize         Int         @map("party_size")
  status            String      @default("confirmed")     // confirmed | canceled
  operationalStatus String      @default("expected") @map("operational_status")
                                                          // expected | seated | departed | no_show
  // When a large party books a TableCombination, one TableReservation row is
  // created per member table, all sharing this group id (cancel/seat operate on
  // the group). Null for ordinary single-table bookings.
  bookingGroupId    String?     @map("booking_group_id")
  // No-show deposit (chunk 1e). depositAmount = required deposit (null = free);
  // depositStatus = none|pending|held|charged|refunded|released; paymentRef is
  // the Stripe/Mollie/demo reference once a deposit is collected by the app.
  depositAmount     Float?      @map("deposit_amount")
  depositStatus     String?     @map("deposit_status")
  paymentRef        String?     @map("payment_ref")
  guestName         String      @map("guest_name")
  guestEmail        String      @map("guest_email")
  guestPhone        String?     @map("guest_phone")
  specialRequests   String?     @map("special_requests")
  internalNotes     String?     @map("internal_notes")
  seatedAt          DateTime?   @map("seated_at")
  departedAt        DateTime?   @map("departed_at")
  reminderSentAt    DateTime?   @map("reminder_sent_at")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table             Table?      @relation(fields: [tableId], references: [id])
  user              User?       @relation(fields: [userId], references: [id])
  invoices          Invoice[]

  @@index([restaurantId, from])
  @@index([tableId, from, to])
  @@index([bookingGroupId])
  @@map("table_reservation")
}

// A predefined joinable set of tables for large parties (the OpenTable /
// SevenRooms model). All member tables must have `combinable = true`. Booking a
// combination creates one TableReservation per member sharing a bookingGroupId.
model TableCombination {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  name         String?
  capacity     Int                                  // combined seating
  tableIds     String[]   @map("table_ids")         // member Table ids
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("table_combination")
}

// A guest waiting for an opening on a given day. When a reservation frees
// capacity, the earliest matching waiting entry is auto-notified by the apps.
model TableWaitlistEntry {
  id            String     @id @default(cuid())
  restaurantId  String     @map("restaurant_id")
  dateISO       String     @map("date_iso")          // venue civil date "YYYY-MM-DD"
  requestedTime String?    @map("requested_time")     // "HH:mm" preference, optional
  partySize     Int        @map("party_size")
  guestName     String     @map("guest_name")
  guestEmail    String     @map("guest_email")
  guestPhone    String?    @map("guest_phone")
  status        String     @default("waiting")        // waiting | notified | converted | expired
  notifiedAt    DateTime?  @map("notified_at")
  userId        String?    @map("user_id")
  anonId        String?    @map("anon_id")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, dateISO, status])
  @@map("table_waitlist_entry")
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  name         String
  description  String?
  price        Float
  imageUrl     String?     @map("image_url")
  category     String      @default("main")
  soldOut      Boolean     @default(false) @map("sold_out")
  active       Boolean     @default(true)
  displayOrder Int         @default(0) @map("display_order")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("menu_item")
}

model RestaurantHours {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  day          Int                                         // 0 (Sun) .. 6 (Sat)
  openTime     String      @map("open_time")               // "HH:mm"
  closeTime    String      @map("close_time")              // "HH:mm"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_hours")
}

// Named service shift (e.g. Lunch, Dinner) for a weekday. When a restaurant has
// shifts for a day, the availability engine uses them instead of RestaurantHours
// (which it falls back to when there are none). Shifts add pacing — a cap on the
// covers (summed party size) that may *start* within each pacing window.
model RestaurantShift {
  id                      String     @id @default(cuid())
  restaurantId            String     @map("restaurant_id")
  name                    String
  day                     Int                                 // 0 (Sun) .. 6 (Sat)
  startTime               String     @map("start_time")       // "HH:mm"
  endTime                 String     @map("end_time")         // "HH:mm"
  // Max covers (sum of party sizes) that may start in one pacing window. Null =
  // unlimited (no pacing on this shift).
  pacingCovers            Int?       @map("pacing_covers")
  pacingWindowMinutes     Int        @default(15) @map("pacing_window_minutes")
  // Latest booking start before the shift ends, as minutes-before-end. Null =
  // only bounded by the meal fitting before end.
  lastSeatingOffsetMinutes Int?      @map("last_seating_offset_minutes")
  // No-show deposit gate (consumed in chunk 1e). When true, this shift requires
  // a deposit for parties ≥ depositMinPartySize.
  requiresDeposit         Boolean    @default(false) @map("requires_deposit")
  depositMinPartySize     Int?       @map("deposit_min_party_size")
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  restaurant              Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, day])
  @@map("restaurant_shift")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model FeatureFlag {
  name        String   @id
  description String
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @map("updated_by")

  @@map("feature_flag")
}

/// Audit + replay-protection record for one impersonation handoff. A row is
/// created when the target app accepts an impersonation token; the unique
/// constraint on `tokenId` (the JTI) makes a second consumption attempt fail
/// with a unique-constraint violation, which the service translates to a
/// replay error.
model ImpersonationLog {
  id           String    @id @default(cuid())
  adminId      String    @map("admin_id")
  targetUserId String    @map("target_user_id")
  tokenId      String    @unique @map("token_id")
  app          String                                 // 'partner' | 'user'
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  ip           String?
  userAgent    String?   @map("user_agent")

  @@index([adminId, startedAt])
  @@index([targetUserId, startedAt])
  @@map("impersonation_log")
}




/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
