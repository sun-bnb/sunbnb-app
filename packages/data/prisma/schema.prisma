generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum SettlementStatus {
  DRAFT
  CLOSED
  APPROVED
  PAID
}

enum SubscriptionTier {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model SubscriptionPlan {
  id              String           @id @default(cuid())
  tier            SubscriptionTier @unique
  name            String
  monthlyPrice    Float            @map("monthly_price")
  maxSites        Int              @map("max_sites")
  stripeProductId String?          @map("stripe_product_id")
  stripePriceId   String?          @map("stripe_price_id")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  partnerAccountId     String             @unique @map("partner_account_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  partnerAccount       PartnerAccount     @relation(fields: [partnerAccountId], references: [userId], onDelete: Cascade)
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
}

model Settings {
  id             String       @id @default(cuid())
  country        String?
  vat            Float?
  currency       String?
  companyName    String?      @map("company_name")
  companyAddress String?      @map("company_address")
  businessId     String?      @map("business_id")
  vatId          String?      @map("vat_id")
  contactEmail   String?      @map("contact_email")
  contactPhone   String?      @map("contact_phone")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  serviceFees    ServiceFee[]
}

model ServiceCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceFee {
  id               String            @id @default(cuid())
  settingsId       String            @map("settings_id")
  siteId           String?           @map("site_id")
  accountId        String?           @map("account_id")
  subscriptionTier SubscriptionTier? @map("subscription_tier")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  chargeType       String            @map("charge_type")
  feeAmount        Float?            @map("fee_amount")
  percentage       Float?
  serviceCode      String            @map("service_code")
  account          PartnerAccount?   @relation(fields: [accountId], references: [userId], onDelete: Cascade)
  settings         Settings          @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  site             Site?             @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model PaymentProcessingFee {
  id          String   @id @default(cuid())
  name        String   @default("Default")
  fixedAmount Float?   @map("fixed_amount")
  percentage  Float?
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String               @id @default(cuid())
  name           String?
  email          String               @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  password       String?
  sudo           Boolean              @default(false)
  accounts       Account[]
  Authenticator  Authenticator[]
  inventoryItems InventoryItem[]
  orders         Order[]
  partnerAccount PartnerAccount?
  passwordResetTokens PasswordResetToken[]
  rentalBookings RentalBooking[]
  reservations   Reservation[]
  sessions       Session[]
  sites          Site[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model PartnerAccount {
  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  email       String
  phoneNumber String       @map("phone_number")
  company     String
  websiteUrl  String?      @map("website_url")
  address     String
  city        String?
  postalCode  String?      @map("postal_code")
  country     String?
  bankAccount          String?      @map("bank_account")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  userId               String       @id @unique @map("user_id")
  businessId           String?      @map("business_id")
  mollieProfileId      String?      @map("mollie_profile_id")
  mollieAccessToken    String?      @map("mollie_access_token")
  mollieRefreshToken   String?      @map("mollie_refresh_token")
  mollieOnboardingStatus String?    @map("mollie_onboarding_status")
  invoices     Invoice[]
  settlements  Settlement[]
  subscription Subscription?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceFees  ServiceFee[]
}

model Site {
  id              String                   @id @unique @default(cuid())
  userId          String                   @map("user_id")
  name            String
  locationLat     String                   @map("location_lat")
  locationLng     String                   @map("location_lng")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  description     String?
  image           String?
  coords          Unsupported("geometry")?
  price           Float?
  imageHeight     Int?                     @map("image_height")
  imageWidth      Int?                     @map("image_width")
  services        String[]                 @default([])
  vat             Float?
  rentalVat       Float?                   @map("rental_vat")
  rentalPaymentType String?                @map("rental_payment_type")
  status          String                   @default("active")
  appSalesEnabled Boolean                  @default(false) @map("app_sales_enabled")
  type            String?
  orderPaymentType String?                 @map("order_payment_type")
  background      String?
  bgImageUrl      String?                  @map("bg_image_url")
  bgImageWidth    Int?                     @map("bg_image_width")
  bgImageHeight   Int?                     @map("bg_image_height")
  slug            String?
  paymentProvider String                   @default("mollie") @map("payment_provider")
  noShowDeadlineMinutes Int?                @map("no_show_deadline_minutes")
  features        String[]                 @default(["sunbeds"])
  layoutMode      String                   @default("geo") @map("layout_mode")
  layoutWidth     Float?                   @map("layout_width")
  layoutHeight    Float?                   @map("layout_height")

  inventoryItems  InventoryItem[]
  layoutElements  LayoutElement[]
  orders          Order[]
  products        Product[]
  rentalItems     RentalItem[]
  rentalBookings  RentalBooking[]
  reservations    Reservation[]
  serviceFees     ServiceFee[]
  settlements     Settlement[]
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workingHours    SiteWorkingHours[]
  brand           SiteBrand?

  @@index([coords], map: "site_coords_idx", type: Gist)
}

model SiteBrand {
  id              String                   @id @unique @default(cuid())
  siteId          String                   @map("site_id") @unique
  brandName       String
  tagline         String?
  primaryColor    String?                  @map("primary_color")
  accentColor     String?                  @map("accent_color")
  bgColor         String?                  @map("bg_color")
  fgColor         String?                  @map("fg_color")
  logoUrl         String?                  @map("logo_url")
  bgImageUrl      String?                  @map("bg_image_url")
  bgImageWidth    Int?                     @map("bg_image_width")
  bgImageHeight   Int?                     @map("bg_image_height")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteWorkingHours {
  id        String   @id @unique @default(cuid())
  siteId    String   @map("site_id")
  day       Int
  openTime  DateTime @map("open_time")
  closeTime DateTime @map("close_time")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id           String         @id @unique @default(cuid())
  userId       String         @map("user_id")
  siteId       String         @map("site_id")
  number       Int
  locationLat  String         @map("location_lat")
  locationLng  String         @map("location_lng")
  schematicX   Float?         @map("schematic_x")
  schematicY   Float?         @map("schematic_y")
  status       String
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  image        String?
  label        String?
  rotation     Int?
  category     String?
  price        Float?
  pairId       String?        @unique @map("pair_id")
  group        Int            @default(0)
  itemGroupId  String?        @map("item_group_id")
  itemGroup    ItemGroup?     @relation(fields: [itemGroupId], references: [id])
  pair         InventoryItem? @relation("ItemPair", fields: [pairId], references: [id])
  pairedBy     InventoryItem? @relation("ItemPair")
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]  @relation("InventoryItemToReservation")
}

model ItemGroup {
  id            String          @id @unique @default(cuid())
  number        Int
  label         String?
  rows          Int
  seatsPerRow   Int             @map("seats_per_row")
  locationLat   String          @map("location_lat")
  locationLng   String          @map("location_lng")
  schematicX    Float?          @map("schematic_x")
  schematicY    Float?          @map("schematic_y")
  status        String          @default("active")
  rotation      Int             @default(0)
  horizontalGap Float           @map("horizontal_gap")
  verticalGap   Float           @map("vertical_gap")
  pairGap       Float           @map("pair_gap")
  category      String?
  price         Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         InventoryItem[]
}

model LayoutElement {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  type      String
  shape     String
  x         Float
  y         Float
  width     Float
  height    Float
  rotation  Float    @default(0)
  z         Int      @default(0)
  label        String?
  color        String?
  cornerRadius Float?   @default(0) @map("corner_radius")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("layout_element")
}

model Reservation {
  id                String          @id @unique @default(cuid())
  userId            String          @map("user_id")
  siteId            String          @map("site_id")
  itemId            String?         @map("item_id")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  status            String          @default("pending")
  operationalStatus String          @default("expected") @map("operational_status")
  type              String          @default("hours")
  from              DateTime        @map("from")
  to                DateTime        @map("to")
  paymentAmount     Float?          @map("payment_amount")
  paymentRef        String?         @map("payment_ref")
  anonId            String?         @map("anon_id")
  checkedInAt       DateTime?       @map("checked_in_at")
  departedAt        DateTime?       @map("departed_at")
  guestName         String?         @map("guest_name")
  guestContact      String?         @map("guest_contact")
  internalNotes     String?         @map("internal_notes")
  reminderSentAt    DateTime?       @map("reminder_sent_at")
  orders            Order[]
  invoices          Invoice[]
  site              Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             InventoryItem[] @relation("InventoryItemToReservation")
}

model Product {
  id          String   @id @unique @default(cuid())
  name        String
  description String?
  price       Float
  tax         Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  siteId      String   @map("site_id")
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  imageHeight Int?     @map("image_height")
  imageWidth  Int?     @map("image_width")
  category    String?  @default("food")
  soldOut     Boolean  @default(false) @map("sold_out")
  prepTime    Int?     @map("prep_time")
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Order {
  id            String         @id @unique @default(cuid())
  price         Float
  tax           Float
  totalPrice    Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  siteId        String         @map("site_id")
  status        String         @default("created")
  anonId        String?        @map("anon_id")
  paymentAmount Float?         @map("payment_amount")
  paymentRef    String?        @map("payment_ref")
  userId        String         @map("user_id")
  reservationId String?        @map("reservation_id")
  seatId        String?        @map("seat_id")
  notes         String?
  rejectReason  String?        @map("reject_reason")
  acceptedAt    DateTime?      @map("accepted_at")
  readyAt       DateTime?      @map("ready_at")
  deliveredAt   DateTime?      @map("delivered_at")
  invoices      Invoice[]
  reservation   Reservation?   @relation(fields: [reservationId], references: [id])
  seat          InventoryItem? @relation(fields: [seatId], references: [id])
  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
}

model OrderItem {
  id         String   @id @unique @default(cuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  price      Float
  tax        Float
  totalPrice Float
  notes      String?
  category   String?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String         @id @unique @default(cuid())
  accountId    String         @map("account_id")
  status       String         @default("created")
  paymentRef   String?        @map("payment_ref")
  totalCharge  Float          @map("total_charge")
  totalTax     Float          @default(0) @map("total_tax")
  totalAmount  Float          @map("total_amount")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  invoicedAt       DateTime          @default(now()) @map("invoiced_at")
  issuerType       String            @default("PARTNER") @map("issuer_type")
  issuerVatNumber  String?           @map("issuer_vat_number")
  issuerCompanyName   String?        @map("issuer_company_name")
  issuerCompanyAddress String?       @map("issuer_company_address")
  settlementId     String?           @map("settlement_id")
  settlementBatchId String?          @map("settlement_batch_id")
  reservationId    String?           @map("reservation_id")
  orderId          String?           @map("order_id")
  invoiceNumber    String?           @unique @map("invoice_number")
  previousHash     String?           @map("previous_hash")
  hash             String?
  account          PartnerAccount    @relation(fields: [accountId], references: [userId], onDelete: Cascade)
  settlementBatch  Settlement?       @relation(fields: [settlementBatchId], references: [id])
  reservation      Reservation?      @relation(fields: [reservationId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  invoiceLines     InvoiceLine[]
}

model Settlement {
  id             String           @id @default(cuid())
  accountId      String           @map("account_id")
  siteId         String           @map("site_id")
  periodStart    DateTime         @map("period_start")
  periodEnd      DateTime         @map("period_end")
  grossRevenue   Float            @map("gross_revenue")
  totalTax       Float            @default(0) @map("total_tax")
  commission     Float
  netPayout      Float            @map("net_payout")
  currency       String           @default("EUR")
  status         SettlementStatus @default(DRAFT)
  bankReference  String?          @map("bank_reference")
  paidAt         DateTime?        @map("paid_at")
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  account        PartnerAccount   @relation(fields: [accountId], references: [userId])
  site           Site             @relation(fields: [siteId], references: [id])
  invoices       Invoice[]
}

model InvoiceLine {
  id          String   @id @unique @default(cuid())
  invoiceId   String   @map("invoice_id")
  charge      Float
  tax         Float    @default(0)
  amount      Float
  vatRate     Float?   @map("vat_rate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  productCode String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model SecurityToken {
  id        String   @id @unique @default(cuid())
  expires   DateTime
  resources String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @map("user_id")
}

model RentalItem {
  id            String          @id @unique @default(cuid())
  siteId        String          @map("site_id")
  name          String
  description   String?
  imageUrl      String?         @map("image_url")
  category      String?
  pricePerHour  Float?          @map("price_per_hour")
  pricePerDay   Float?          @map("price_per_day")
  totalQuantity Int             @default(1) @map("total_quantity")
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  site          Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  bookings      RentalBooking[]
}

model RentalBooking {
  id                String     @id @unique @default(cuid())
  siteId            String     @map("site_id")
  rentalItemId      String     @map("rental_item_id")
  userId            String     @map("user_id")
  from              DateTime
  to                DateTime
  quantity          Int        @default(1)
  durationType      String     @default("hours") @map("duration_type")
  totalPrice        Float      @map("total_price")
  status            String     @default("pending")
  operationalStatus String     @default("reserved") @map("operational_status")
  guestName         String?    @map("guest_name")
  paymentRef        String?    @map("payment_ref")
  paymentAmount     Float?     @map("payment_amount")
  pickedUpAt        DateTime?  @map("picked_up_at")
  returnedAt        DateTime?  @map("returned_at")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  site              Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rentalItem        RentalItem @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}




/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
